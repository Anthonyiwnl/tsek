# Backend server configuration
PORT=3000

# PostgreSQL database connection
DATABASE_URL=

# OpenAI API configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Authentication configuration
JWT_SECRET=

# Frontend URL for backend configuration
FRONTEND_URL=

# Public Neon Auth URL; backend uses the same /auth endpoint
NEON_AUTH_BASE_URL=
# Set this separately in frontend/.env.local or the frontend build environment
VITE_NEON_AUTH_URL=
