# Reference template only: create backend/.env from backend/.env.example.
# Backend scripts load .env from the backend working directory.

# Backend (Node.js 24)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-side only. Neon pooled URL for the running API.
# Copy from Neon Connect, then set sslmode=verify-full; keep channel_binding=require.
DATABASE_URL=

# Neon direct (non-pooler) URL for migrations and seed; same database/branch.
DIRECT_DATABASE_URL=

# Reserved for Week 1 Task 4; not required by the catalogue API.
OPENAI_API_KEY=

# Reserved for later AI/auth work; not required by the catalogue API.
OPENAI_MODEL=gpt-4.1-mini
JWT_SECRET=
