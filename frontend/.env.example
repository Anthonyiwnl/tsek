# Frontend (Vite). Copy the VITE_ entries to frontend/.env.local for local
# overrides.
#
# Every VITE_ variable is compiled into the public JavaScript bundle.
# Never put a secret here; keep API keys and database credentials on the backend.

# Optional. The checklist uses the local sample endpoint by default.
# Default: /api/services, served by a Vite plugin locally and as a Vercel
# function when deployed. It returns synthetic sample fixtures.
VITE_SERVICES_ENDPOINT=

# Set automatically by Vercel at build time for the deploy smoke test.
# Leave empty locally.
VITE_VERCEL_GIT_COMMIT_SHA=

# Public Neon Auth endpoint for existing accounts (same auth instance as backend).
VITE_NEON_AUTH_URL=

# Required on Vercel: backend API base URL including /api.
# Locally defaults to /api through the development proxy.
VITE_API_BASE_URL=

# Development proxy target; defaults to http://localhost:3000.
VITE_API_PROXY_TARGET=
