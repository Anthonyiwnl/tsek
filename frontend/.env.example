# Frontend (Vite). Copy the VITE_ entries to frontend/.env.local for local
# overrides; TSEK_BACKEND_URL is set differently (see below).
#
# Every VITE_ variable is compiled into the public JavaScript bundle.
# Never put a secret here: the browser talks only to the TSEK backend, which
# holds every key (the bundle audit fails the build if one leaks in).

# Optional. Where the requirements checklist loads services from.
# Default: /api/services, the handler in frontend/api/services.js (served by a
# Vite plugin locally and as a Vercel function when deployed).
VITE_SERVICES_ENDPOINT=

# Server-side only (read by frontend/api/services.js, never sent to the
# browser). The backend origin, e.g. https://tsek-fl10.onrender.com. When set,
# /api/services serves the database catalogue; when empty, sample fixtures.
# On Vercel, set it in the project's environment variables. Locally, Vite does
# not pass .env.local to the handler, so export it in the shell instead:
#   PowerShell: $env:TSEK_BACKEND_URL="http://localhost:3000"; npm run dev
#   bash:       TSEK_BACKEND_URL=http://localhost:3000 npm run dev
TSEK_BACKEND_URL=

# Set automatically by Vercel at build time (deployed commit, read by the
# deploy smoke test from <meta name="tsek-commit">). Leave empty locally.
VITE_VERCEL_GIT_COMMIT_SHA=
