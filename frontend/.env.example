# Frontend (Vite). Copy to frontend/.env.local for local overrides.
#
# Every VITE_ variable is compiled into the public JavaScript bundle.
# Never put a secret here: the browser talks only to the TSEK backend, which
# holds every key (the bundle audit fails the build if one leaks in).

# Optional. Where the requirements checklist loads services from.
# Default: /api/services (proxied to the backend by vite.config.js locally,
# and by the Vercel project in staging and production).
VITE_SERVICES_ENDPOINT=

# Set automatically by Vercel at build time (deployed commit, read by the
# deploy smoke test from <meta name="tsek-commit">). Leave empty locally.
VITE_VERCEL_GIT_COMMIT_SHA=
