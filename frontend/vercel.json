{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/services.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/api/document-types/:path*",
      "destination": "https://tsek-fl10.onrender.com/api/document-types/:path*"
    },
    {
      "source": "/api/applications/:path*",
      "destination": "https://tsek-fl10.onrender.com/api/applications/:path*"
    }
  ]
}
