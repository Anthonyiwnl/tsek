{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsek.app/schemas/document-analysis.v1.schema.json",
  "title": "TSEK document analysis",
  "description": "The Sprint 2 contract for extracted document observations and business-rule decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "source",
    "observations",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "uploadedFileId"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "uploadedFileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentType",
        "applicantName",
        "address",
        "readability"
      ],
      "properties": {
        "documentType": {
          "$ref": "#/$defs/textObservation"
        },
        "applicantName": {
          "$ref": "#/$defs/textObservation"
        },
        "address": {
          "$ref": "#/$defs/textObservation"
        },
        "readability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "confidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "clear",
                "partially_readable",
                "unreadable"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "missingInformation"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "complete",
            "incomplete",
            "unreadable",
            "needs_review"
          ]
        },
        "missingInformation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "reason"
            ],
            "properties": {
              "field": {
                "enum": [
                  "documentType",
                  "applicantName",
                  "address"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "textObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
