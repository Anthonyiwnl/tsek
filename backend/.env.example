# Backend (Node.js 24)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-side only. Neon pooled URL for the running API.
# Copy from Neon Connect, then set sslmode=verify-full; keep channel_binding=require.
DATABASE_URL=

# Set one direct (non-pooler) URL for migrations and seed; same database/branch.
# Neon may provide it as DATABASE_URL_UNPOOLED.
DIRECT_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-side only. Use a separate key per environment; set a monthly
# spending limit on the staging key.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini
JWT_SECRET=
