# Backend (Node.js 24)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-side only. Neon pooled URL for the running API.
# Copy from Neon Connect, then set sslmode=verify-full; keep channel_binding=require.
DATABASE_URL=

# Set one direct (non-pooler) URL for migrations and seed; same database/branch.
# Neon may provide it as DATABASE_URL_UNPOOLED.
DIRECT_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only credential. Analysis sends uploaded plain text and application
# requirement details to OpenAI when a user requests an analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=10000

# Neon Managed Auth URL for validating signed user access tokens.
NEON_AUTH_BASE_URL=
# Optional override; otherwise derived from NEON_AUTH_BASE_URL.
NEON_AUTH_JWKS_URL=
