# Backend (Node.js 24)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-side only. Neon pooled URL for the running API.
# Copy from Neon Connect, then set sslmode=verify-full; keep channel_binding=require.
DATABASE_URL=

# Set one direct (non-pooler) URL for migrations and seed; same database/branch.
# Neon may provide it as DATABASE_URL_UNPOOLED.
DIRECT_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth base URL used to verify application bearer tokens.
# Set this to your Neon Auth endpoint; leave blank to keep application routes unavailable.
NEON_AUTH_BASE_URL=
# Optional. Overrides the JWKS URL (default: <NEON_AUTH_BASE_URL>/.well-known/jwks.json).
NEON_AUTH_JWKS_URL=

# AI verification route (POST /api/verify). Off by default.
# Set to true on staging only, never production.
AI_VERIFY_ENABLED=false

# Server-side only. Use a separate key per environment; set a monthly
# spending limit on the staging key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Milliseconds before an OpenAI request fails with PROVIDER_TIMEOUT (default 10000).
OPENAI_TIMEOUT_MS=10000

JWT_SECRET=
