# Backend (Node.js 24)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Server-side only. Neon pooled URL for the running API.
# Copy from Neon Connect, then set sslmode=verify-full; keep channel_binding=require.
DATABASE_URL=

# Set one direct (non-pooler) URL for migrations and seed; same database/branch.
# Neon may provide it as DATABASE_URL_UNPOOLED.
DIRECT_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth base URL used to verify application bearer tokens.
# Set this to your Neon Auth endpoint; leave blank to keep application routes unavailable.
NEON_AUTH_BASE_URL=

# AI verification route (POST /api/verify). Off by default.
# true on staging and production; set false to turn AI off (kill switch).
AI_VERIFY_ENABLED=false

# Server-side only. Use a separate key per environment; set a monthly
# spending limit on the staging key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Milliseconds before an OpenAI request fails with PROVIDER_TIMEOUT (default 10000).
OPENAI_TIMEOUT_MS=10000
# US dollars per million tokens, used only to log costUsd for each AI call.
# Defaults are the gpt-4.1-mini list prices; update them with OPENAI_MODEL.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60

# Set to production on Render (staging and production): Express then runs in
# production mode. Leave empty locally.
NODE_ENV=

# Optional. Overrides the JWKS URL derived from NEON_AUTH_BASE_URL.
NEON_AUTH_JWKS_URL=

# Operator only, for `npm run drill:ai -- --url ...` against staging: a fresh
# staging Neon Auth session JWT (docs/AI_FAILURE_DRILL.md). Never set on Render.
AI_VERIFY_TOKEN=
# Operator and CI only, for `node scripts/eval-production-prompt.js`: the
# model to evaluate (default gpt-4.1-mini). Never set on Render.
EVAL_MODEL=
