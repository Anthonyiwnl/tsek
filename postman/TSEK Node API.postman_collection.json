{
  "info": {
    "name": "TSEK Node API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "documentTypeId",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "List document types",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/document-types"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "if (data.length) pm.collectionVariables.set(\"documentTypeId\", data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Document requirements",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/document-types/{{documentTypeId}}/requirements"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "name": "List my applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an application array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create draft application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type_id\": \"{{documentTypeId}}\",\n  \"purpose\": \"Postman CRUD check\"\n}"
            },
            "url": "{{baseUrl}}/api/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 201\", () => pm.response.to.have.status(201));",
                  "const application = pm.response.json().data;",
                  "pm.collectionVariables.set(\"applicationId\", application.id);",
                  "pm.test(\"Creates a draft\", () => pm.expect(application.status).to.eql(\"draft\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my application",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested application\", () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get(\"applicationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update draft application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Updated in Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updates the purpose\", () => pm.expect(pm.response.json().data.purpose).to.eql(\"Updated in Postman\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete draft application",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
